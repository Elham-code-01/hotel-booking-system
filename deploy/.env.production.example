# Copy this file to .env on the server and fill in the empty values.
# A value that contains $ # or a space must be written between single quotes, like: DB_PASSWORD='my$pass#word'

APP_NAME="Umrah Hotel Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mutamireen
DB_USERNAME=mutamireen
DB_PASSWORD=

# Sessions: stored in the database, encrypted, and sent only over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
